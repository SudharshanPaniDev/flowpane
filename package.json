{
  "name": "flowpane",
  "version": "0.1.0",
  "description": "Accessible React components for workflow-heavy business apps: data tables, steppers, dialogs, and the everyday pieces around them.",
  "keywords": [
    "react",
    "components",
    "ui",
    "design-system",
    "accessibility",
    "data-table",
    "stepper",
    "admin",
    "dashboard"
  ],
  "author": "Sudharshan Pani",
  "license": "MIT",
  "homepage": "https://github.com/SudharshanPaniDev/flowpane#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SudharshanPaniDev/flowpane.git"
  },
  "bugs": "https://github.com/SudharshanPaniDev/flowpane/issues",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --config site/vite.config.ts",
    "storybook": "storybook dev -p 6006",
    "build": "tsup",
    "build:site": "vite build --config site/vite.config.ts",
    "build:docs": "npm run build:site && storybook build -o site-dist/storybook --quiet",
    "preview:site": "vite preview --config site/vite.config.ts",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.6.1",
    "sugar-high": "^2.5.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
